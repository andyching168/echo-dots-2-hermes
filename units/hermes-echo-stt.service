[Unit]
Description=Hermes Echo STT server - one-shot Question Mode (:8797)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/ac/voice/echo-bridge
Environment=PYTHONPATH=/home/ac/.hermes/hermes-agent
Environment=HERMES_HOME=/home/ac/.hermes
ExecStart=/home/ac/.hermes/hermes-agent/venv/bin/python /home/ac/voice/echo-bridge/echo_stt_server.py --host 127.0.0.1 --port 8797
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
